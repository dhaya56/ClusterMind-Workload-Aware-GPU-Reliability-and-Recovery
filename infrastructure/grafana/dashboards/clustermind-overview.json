    {
      "id": 3,
      "type": "stat",
      "title": "Observed GPUs",
      "description": "Latest distinct node/GPU series in the selected range.",
      "datasource": {
        "type": "influxdb",
        "uid": "clustermind-influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"gpu_telemetry\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"gpu_telemetry\" and r._field == \"gpu_utilization_percent\")\n  |> filter(fn: (r) => \"${node}\" == \"All\" or r.node_id == \"${node}\")\n  |> group(columns: [\"node_id\", \"gpu_id\"])\n  |> last()\n  |> group()\n  |> count(column: \"_value\")",
          "datasource": {
            "type": "influxdb",
            "uid": "clustermind-influxdb"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true
      }
