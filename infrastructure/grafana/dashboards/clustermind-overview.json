    {
      "id": 7,
      "type": "gauge",
      "title": "Cluster health score",
      "description": "State-based health score for the selected node/GPU scope.",
      "datasource": {
        "type": "influxdb",
        "uid": "clustermind-influxdb"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"gpu_telemetry\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"gpu_telemetry\" and r._field == \"gpu_utilization_percent\")\n  |> filter(fn: (r) => \"${node}\" == \"All\" or r.node_id == \"${node}\") |> filter(fn: (r) => \"${gpu}\" == \"All\" or r.gpu_id == \"${gpu}\")\n  |> map(fn: (r) => ({ r with _value: if r.operating_state == \"normal\" then 100.0 else if r.operating_state == \"degraded\" then 55.0 else 10.0 }))\n  |> mean(column: \"_value\")",
          "datasource": {
            "type": "influxdb",
            "uid": "clustermind-influxdb"
          }
        }
