# ClusterMind application
APP_NAME=ClusterMind
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Local runtime paths
DATA_DIRECTORY=data/generated
ARTIFACT_DIRECTORY=data/artifacts
MODEL_ARTIFACT_DIRECTORY=app/ml/artifacts
RUNBOOK_DIRECTORY=runbooks

# InfluxDB OSS
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=clustermind
INFLUXDB_BUCKET=gpu_telemetry
INFLUXDB_TOKEN=clustermind-development-token
INFLUXDB_TIMEOUT_MS=10000

# Redis and Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120

# Prometheus
PROMETHEUS_METRICS_PATH=/metrics

# OpenTelemetry and Jaeger
OTEL_ENABLED=true
OTEL_SERVICE_NAME=clustermind-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# Self-hosted ntfy notifications
NTFY_ENABLED=false
NTFY_BASE_URL=http://localhost:8080
NTFY_TOPIC=clustermind-alerts

# Optional generic SMTP notifications
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_TO_ADDRESS=
SMTP_USE_TLS=true

# Browser clients allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Docker Compose isolation
COMPOSE_PROJECT_NAME=clustermind

# ClusterMind host ports
CLUSTERMIND_API_HOST_PORT=18000
CLUSTERMIND_INFLUXDB_HOST_PORT=18086
CLUSTERMIND_PROMETHEUS_HOST_PORT=19090
CLUSTERMIND_GRAFANA_HOST_PORT=13000
CLUSTERMIND_REDIS_HOST_PORT=16379
CLUSTERMIND_JAEGER_HOST_PORT=16686
CLUSTERMIND_OTEL_GRPC_HOST_PORT=14317
CLUSTERMIND_OTEL_HTTP_HOST_PORT=14318
CLUSTERMIND_OTEL_HEALTH_HOST_PORT=13133

# Grafana local administrator account
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=clustermind-admin